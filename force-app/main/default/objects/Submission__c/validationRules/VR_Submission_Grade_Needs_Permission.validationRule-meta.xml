<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Submission_Grade_Needs_Permission</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISCHANGED(Status__c), ISPICKVAL(Status__c,&apos;Graded&apos;), NOT($Permission.TMS_Grade_Submissions))</errorConditionFormula>
    <errorMessage>You do not have permission to grade submissions.</errorMessage>
</ValidationRule>
