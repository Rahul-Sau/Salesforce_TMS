<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Submission_Score_Required_To_Grade</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c,&apos;Graded&apos;), ISBLANK(Score_Obtained__c))</errorConditionFormula>
    <errorDisplayField>Score_Obtained__c</errorDisplayField>
    <errorMessage>Enter a score before grading.</errorMessage>
</ValidationRule>
