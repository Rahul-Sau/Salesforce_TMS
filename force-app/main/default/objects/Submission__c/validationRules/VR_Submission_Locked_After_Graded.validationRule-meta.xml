<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Submission_Locked_After_Graded</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISNEW()), ISPICKVAL(PRIORVALUE(Status__c),&apos;Graded&apos;),
NOT($Permission.TMS_Grade_Submissions))</errorConditionFormula>
    <errorMessage>A graded submission cannot be edited.</errorMessage>
</ValidationRule>
