<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Submission_Content_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c,&apos;Submitted&apos;), ISBLANK(Submission_Text__c), ISBLANK(Submission_Link__c))</errorConditionFormula>
    <errorDisplayField>Submission_Text__c</errorDisplayField>
    <errorMessage>Add your answer text or a link before submitting.</errorMessage>
</ValidationRule>
