<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Batch_End_After_Start</fullName>
    <active>true</active>
    <errorConditionFormula>OR(End_Date__c &lt;= Start_Date__c, Enrollment_Close_Date__c &gt; Start_Date__c)</errorConditionFormula>
    <errorMessage>End date must be after start date, and enrollment must close on or before the start date.</errorMessage>
</ValidationRule>
