<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Batch_Seats_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Max_Seats__c &lt;= 0, Max_Seats__c &lt; BLANKVALUE(Seats_Taken__c, 0))</errorConditionFormula>
    <errorDisplayField>Max_Seats__c</errorDisplayField>
    <errorMessage>Max seats must be above 0 and not below seats already taken.</errorMessage>
</ValidationRule>
