<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Course_Pass_Mark_Range</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Pass_Mark__c &lt; 0, Pass_Mark__c &gt; 100)</errorConditionFormula>
    <errorDisplayField>Pass_Mark__c</errorDisplayField>
    <errorMessage>Pass mark must be between 0 and 100.</errorMessage>
</ValidationRule>
