<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Assessment_Status_Order</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISNEW()), ISCHANGED(Status__c), OR(ISPICKVAL(Status__c,&apos;Draft&apos;), AND(ISPICKVAL(Status__c,&apos;Published&apos;), NOT(ISPICKVAL(PRIORVALUE(Status__c),&apos;Draft&apos;)))))</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>Assessments move Draft, then Published, then Closed. A published assessment cannot be reopened.</errorMessage>
</ValidationRule>
