<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Assessment_Trainer_Must_Own_Batch</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(ISNEW(), ISCHANGED(Course_Batch__c)), NOT(ISBLANK($User.ContactId)), Course_Batch__r.Trainer__c &lt;&gt; $User.ContactId)</errorConditionFormula>
    <errorDisplayField>Course_Batch__c</errorDisplayField>
    <errorMessage>You can only add assessments to your own batches.</errorMessage>
</ValidationRule>
