<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Append_Batch_to_Answer</name>
        <label>Append Batch to Answer</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>answer</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Updated_Answer</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Batches</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_No_Batches_Message</name>
        <label>Set No Batches Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>answer</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>There are no open batches right now.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_If_Batches_Found</name>
        <label>Check If Batches Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Batches Found</defaultConnectorLabel>
        <rules>
            <name>No_Batches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>answer</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_No_Batches_Message</targetReference>
            </connector>
            <label>No Batches</label>
        </rules>
    </decisions>
    <description>Lists batches that are open for enrollment, with course, category, level, seats left and start date</description>
    <environments>Default</environments>
    <formulas>
        <name>Batch_Line</name>
        <dataType>String</dataType>
        <expression>&quot;• &quot; &amp;
{!Loop_Through_Batches.Name} &amp;
&quot; | &quot; &amp;
{!Loop_Through_Batches.Course_Title__c} &amp;
&quot; | &quot; &amp;
{!Loop_Through_Batches.Course_Category__c} &amp;
&quot; | &quot; &amp;
{!Loop_Through_Batches.Course_Level__c} &amp;
&quot; | seats left &quot; &amp;
TEXT({!Loop_Through_Batches.Seats_Available__c}) &amp;
&quot; | starts &quot; &amp;
TEXT({!Loop_Through_Batches.Start_Date__c}) &amp;
BR()</expression>
    </formulas>
    <formulas>
        <name>Updated_Answer</name>
        <dataType>String</dataType>
        <expression>{!answer} &amp; {!Batch_Line}</expression>
    </formulas>
    <interviewLabel>TMS AGT Open Batches {!$Flow.CurrentDateTime}</interviewLabel>
    <label>TMS AGT Open Batches</label>
    <loops>
        <name>Loop_Through_Batches</name>
        <label>Loop Through Batches</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Open_Batches</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Append_Batch_to_Answer</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_If_Batches_Found</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Open_Batches</name>
        <label>Get Open Batches</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Batches</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Is_Open_For_Enrollment__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Course_Batch__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Open_Batches</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>answer</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Optional word to narrow the list, for example Flow. Leave empty to list all open batches.</description>
        <name>courseKeyword</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
