    <decisions>
        <name>Due_soon</name>
        <label>Due soon</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_due_soon</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Due_Date_Snapshot__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>fxTomorrow</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Due_Date_Snapshot__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>fxDayAfter</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Enrollment__r.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Real_address_rem</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
