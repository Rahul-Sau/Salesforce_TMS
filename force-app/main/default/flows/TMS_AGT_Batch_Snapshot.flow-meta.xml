    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Batch_assignment</name>
        <label>Batch assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>answer</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>tplBatch</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Not_Found</name>
        <label>Not Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>answer</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>I couldn&apos;t find a batch with that name.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Error</name>
        <label>Set Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>answer</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>I couldn&apos;t look that up right now. Please try again or ask an administrator.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Batch_found</name>
        <label>Batch found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Batch</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Batch_assignment</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Gives the status, seat usage, weightage and trainer of one batch. Needs the batch name.</description>
    <environments>Default</environments>
    <interviewLabel>TMS AGT Batch Snapshot {!$Flow.CurrentDateTime}</interviewLabel>
    <label>TMS AGT Batch Snapshot</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Batch</name>
        <label>Get Batch</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Batch_found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>batchName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Course_Batch__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Batch</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>tplBatch</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;{!Get_Batch.Name}: status {!Get_Batch.Status__c}, seats taken {!Get_Batch.Seats_Taken__c} of {!Get_Batch.Max_Seats__c}, weightage {!Get_Batch.Total_Weightage__c}, trainer {!Get_Batch.Trainer_Name__c}.&lt;/p&gt;</text>
    </textTemplates>
    <variables>
