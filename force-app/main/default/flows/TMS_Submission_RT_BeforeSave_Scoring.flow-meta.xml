        </rules>
        <rules>
            <name>Submitted_case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Submitted_On__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stamp_submitted</targetReference>
            </connector>
            <label>Submitted</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fxWeighted</name>
        <dataType>Number</dataType>
        <expression>IF({!$Record.Max_Score_Snapshot__c} &gt; 0, ROUND((BLANKVALUE({!$Record.Score_Obtained__c}, 0) / {!$Record.Max_Score_Snapshot__c}) * {!$Record.Weightage_Snapshot__c}, 2), 0)</expression>
