    <formulas>
        <name>fxBody</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Status__c},&apos;Approved&apos;),
&apos;Good news! Your seat in &apos; &amp; {!$Record.Course_Batch__r.Name} &amp; &apos; is confirmed.&apos;,
IF(ISPICKVAL({!$Record.Status__c},&apos;Waitlisted&apos;),
&apos;The batch &apos; &amp; {!$Record.Course_Batch__r.Name} &amp; &apos; is full. You are on the waitlist and will be notified if a seat opens.&apos;,
&apos;Sorry, your enrollment for &apos; &amp; {!$Record.Course_Batch__r.Name} &amp; &apos; was not approved.&apos;))</expression>
    </formulas>
    <formulas>
        <name>fxSubject</name>
